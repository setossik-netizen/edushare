# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service role key to the browser.
# Only used by server-side scripts (seed, maintenance).
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (stockage centralisé automatisé) — serveur uniquement
# ID du dossier Google Drive de destination.
GOOGLE_DRIVE_FOLDER_ID=

# Option A (recommandé, compte Google personnel/gratuit) — OAuth du propriétaire du Drive :
# nécessite une autorisation unique pour obtenir un refresh token (les uploads utilisent le quota du propriétaire).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B (compte de service) — nécessite un Shared Drive/Google Workspace pour le quota.
# JSON du compte de service (brut ou encodé en base64).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Email transactionnel (optionnel) — Resend
RESEND_API_KEY=
EMAIL_FROM=EduShare <noreply@edushare.app>
